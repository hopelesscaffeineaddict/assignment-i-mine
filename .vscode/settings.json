{
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.checkstyle.version": "12.1.2",
  "java.checkstyle.configuration": "${workspaceFolder}/config/checkstyle.xml",
  "java.format.comments.enabled": false,
  "java.import.gradle.version": "9.2.0",
  "editor.formatOnSave": true,
  "editor.tabSize": 4,
  "editor.detectIndentation": false,
  "editor.glyphMargin": true,
  "workbench.editor.showIcons": true,
  "search.exclude": {
    ".vscode/.agent": true,
    ".claude/**": true,
    ".codex/**": true,
    ".gemini/**": true,
    ".codex": true
  },
  "files.exclude": {
    ".vscode/.agent": true,
    ".claude/**": true,
    ".codex/**": true,
    ".gemini/**": true,
    ".codex": true
  },
  "editor.insertSpaces": true
}
